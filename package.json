{
  "name": "jylli-tool",
  "version": "1.6.0",
  "description": "Jylli Tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "check": "node tools/check.js && node tools/scan-injection.js && node tools/check-ui.js && node tools/check-contrast.js && node tools/check-keys.js && node tools/check-vendor.js && node tools/journal-coverage.js --check",
    "test": "node --test \"test/**/*.test.js\"",
    "preview": "electron tools/ui-preview/preview-main.js",
    "build:uninstaller": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/installer/build.ps1 -Uninstaller",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/installer/build.ps1",
    "dist": "npm run build:uninstaller && npm run build && npm run build:installer",
    "promo:analyze": "node tools/promo/analyze.js",
    "promo:shoot": "node tools/promo/shoot.js",
    "promo:render": "electron tools/promo/render.js"
  },
  "build": {
    "appId": "com.jylli.tool",
    "productName": "Jylli Tool",
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "*.html",
      "css/**",
      "js/**",
      "lib/**",
      "assets/**",
      "!assets/**/*.md",
      "!assets/**/.gitkeep",
      "package.json",
      "!design-*.html"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Jylli-Tool-Setup.exe",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "include": "build/installer.nsh"
    },
    "asarUnpack": [
      "lib/os-poller.ps1",
      "assets/lhm/**",
      "assets/fancontrol/**",
      "assets/cpuz/**",
      "assets/ryzenadj/**",
      "assets/scewin/**",
      "assets/presentmon/**",
      "assets/sensor/**",
      "assets/DDU/**",
      "assets/runtimes/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Jyllipete",
      "repo": "jylli-tool",
      "releaseType": "release"
    },
    "extraFiles": [
      {
        "from": "build/extra/Jylli Tool Uninstaller.exe",
        "to": "Jylli Tool Uninstaller.exe"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.24.2",
    "ffmpeg-static": "^5.3.0",
    "three": "0.170.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.11"
  }
}
